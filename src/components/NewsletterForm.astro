---
import { siteConfig } from '../config/site';

/**
 * Single newsletter signup form (Netlify Forms). Used by the homepage and the
 * global footer. Variant only changes class hooks + the input id (so two can
 * coexist on one page without an id clash). Copy comes from siteConfig.forms.
 */
interface Props {
  variant?: 'page' | 'footer';
}
const { variant = 'page' } = Astro.props;
const id = variant === 'footer' ? 'foot-news-email' : 'news-email';
const rowClass = variant === 'footer' ? 'foot-news-row' : 'news-row';
const formClass = variant === 'footer' ? 'foot-news-form' : 'news-form';
---

<form
  name="newsletter"
  method="POST"
  data-netlify="true"
  netlify-honeypot="bot-field"
  class={formClass}
  data-success={siteConfig.forms.newsletterSuccess}
  data-error={siteConfig.forms.error}
>
  <input type="hidden" name="form-name" value="newsletter" />
  <p class="visually-hidden"><label>Don’t fill this out: <input name="bot-field" /></label></p>
  <label class="visually-hidden" for={id}>Email address</label>
  <div class={rowClass}>
    <input id={id} type="email" name="email" required placeholder="you@email.com" autocomplete="email" />
    <button type="submit" class="btn btn-coral">Notify me</button>
  </div>
</form>
