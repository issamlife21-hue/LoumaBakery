---
import { siteConfig } from '../config/site';

interface Props {
  transparent?: boolean;
}
const { transparent = false } = Astro.props;

// Nav links — single source. `Order` CTA is separate (external).
const links = [
  { label: 'Menu', href: '/menu' },
  { label: 'Our Story', href: '/story' },
  { label: 'Mission', href: '/mission' },
  { label: 'Catering', href: '/catering' },
  { label: 'Careers', href: '/careers' },
  { label: 'Visit', href: '/visit' },
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href;

// Order link is a placeholder until a real Uber Eats URL is set.
const orderReady = !!siteConfig.links.uberEats && siteConfig.links.uberEats !== 'https://www.ubereats.com/';
---

<nav class="site-nav" data-transparent={String(transparent)} aria-label="Primary">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label={`${siteConfig.name} — home`}>Louma</a>

    <ul class="nav-links" role="list">
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="nav-right">
      {orderReady ? (
        <a class="order-cta" href={siteConfig.links.uberEats} target="_blank" rel="noopener">Order</a>
      ) : (
        <span class="order-cta is-inert" aria-disabled="true" title="Online ordering opens with the bakery.">Ordering soon</span>
      )}
      <button
        type="button"
        class="nav-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-panel"
      >
        <span class="nav-toggle-bar"></span>
        <span class="nav-toggle-bar"></span>
      </button>
    </div>
  </div>

  <!-- Mobile slide-in panel -->
  <div class="mobile-overlay" data-overlay hidden></div>
  <aside id="mobile-panel" class="mobile-panel" aria-label="Menu" aria-hidden="true" hidden>
    <ul class="mobile-links" role="list">
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
              {l.label}
            </a>
          </li>
        ))
      }
      <li>
        {orderReady ? (
          <a class="order-cta order-cta--block" href={siteConfig.links.uberEats} target="_blank" rel="noopener">Order on Uber Eats</a>
        ) : (
          <span class="order-cta order-cta--block is-inert" aria-disabled="true">Ordering soon</span>
        )}
      </li>
    </ul>
  </aside>
</nav>

{/* No-JS fallback: the mobile toggle needs JS, so without it surface the links
    inline and hide the dead toggle — mobile visitors keep their navigation. */}
<noscript>
  <style>
    @media (max-width: 860px) {
      .nav-toggle { display: none !important; }
      .nav-links {
        display: flex !important;
        flex-wrap: wrap;
        gap: 0.5rem 1rem;
        justify-content: flex-end;
      }
    }
  </style>
</noscript>

<style>
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
  }

  .brand {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(24px, 3vw, 30px);
    letter-spacing: 0.01em;
    color: var(--ink);
    text-decoration: none;
    line-height: 1;
  }
  .site-nav[data-transparent='true']:not([data-scrolled='true']) .brand {
    color: var(--surface-0);
  }

  .nav-links {
    display: flex;
    gap: clamp(0.75rem, 2vw, 1.75rem);
    margin: 0;
    padding: 0;
  }
  .nav-links a {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 15px;
    color: var(--body);
    text-decoration: none;
    padding: 0.4rem 0;
    position: relative;
  }
  .nav-links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--red);
  }
  .nav-links a:hover {
    color: var(--burgundy);
  }
  .site-nav[data-transparent='true']:not([data-scrolled='true']) .nav-links a {
    color: color-mix(in srgb, var(--surface-0) 88%, transparent);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .order-cta {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    background: var(--burgundy);
    color: var(--butter);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: var(--radius-pill);
    transition: background var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
  }
  .order-cta:hover {
    background: var(--red);
    color: var(--surface-0);
  }
  /* Inert "Ordering soon" until a real Order link exists. */
  .order-cta.is-inert {
    background: color-mix(in srgb, var(--burgundy) 45%, var(--muted));
    color: color-mix(in srgb, var(--butter) 85%, transparent);
    cursor: default;
  }

  /* Hide-on-scroll-down / show-on-scroll-up (keeps the glass state). */
  .site-nav { transition: transform 0.35s var(--ease-out); will-change: transform; }
  .site-nav[data-hidden='true'] { transform: translateY(-100%); }
  @media (prefers-reduced-motion: reduce) {
    .site-nav { transition: none; }
    .site-nav[data-hidden='true'] { transform: none; }
  }

  /* --- Mobile toggle (hidden on desktop) --- */
  .nav-toggle {
    display: none;
    width: 44px;
    height: 44px;
    background: transparent;
    border: 0;
    padding: 10px;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
  }
  .nav-toggle-bar {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--ink);
    transition: transform var(--dur-fast) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
  }
  .site-nav[data-transparent='true']:not([data-scrolled='true']) .nav-toggle-bar {
    background: var(--surface-0);
  }

  /* Open: lift the bar above the overlay/panel so the close control is visible
     and tappable, and morph the hamburger into an X. */
  .site-nav[data-menu-open='true'] { z-index: 1300; }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:first-child {
    transform: translateY(4px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] .nav-toggle-bar:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* --- Mobile panel --- */
  .mobile-overlay {
    position: fixed;
    inset: 0;
    z-index: 1100;
    background: color-mix(in srgb, var(--ink) 45%, transparent);
  }
  .mobile-panel {
    position: fixed;
    inset-block: 0;
    inset-inline-end: 0;
    z-index: 1200;
    width: min(82vw, 360px);
    background: var(--surface-1);
    box-shadow: var(--shadow-lg);
    padding: calc(var(--nav-h) + var(--space-4)) var(--space-6) var(--space-6);
    transform: translateX(100%);
    transition: transform var(--dur) var(--ease-out);
  }
  .mobile-panel[data-open='true'] {
    transform: translateX(0);
  }
  .mobile-links {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
  }
  .mobile-links a {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-family: var(--font-display);
    font-size: 22px;
    color: var(--ink);
    text-decoration: none;
  }
  .mobile-links a[aria-current='page'] {
    color: var(--red);
  }
  .order-cta--block {
    margin-top: var(--space-4);
    justify-content: center;
    min-height: 48px;
    font-size: 14px;
  }

  /* --- Breakpoint --- */
  @media (max-width: 860px) {
    .nav-links,
    .nav-right .order-cta {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }

  /* Reduced motion: no slide, instant show. */
  @media (prefers-reduced-motion: reduce) {
    .mobile-panel {
      transition: none;
    }
  }
</style>

<script>
  // Nav behavior: scroll-glass toggle, mobile panel with focus trap + Esc.
  // Bound per page-load: with view transitions the nav DOM is swapped on every
  // navigation, so a run-once module leaves the fresh nav with NO scroll
  // listener → data-scrolled never flips → the bar sits transparent over light
  // content. init() re-queries and re-binds; the window listener is cleaned up
  // before re-adding so navigations can't stack handlers.
  let cleanupScroll: (() => void) | null = null;

  function initNav() {
    const nav = document.querySelector<HTMLElement>('.site-nav');
    // Guard on element identity: first load fires BOTH the ready path and
    // astro:page-load; a second bind on the same nav would double every click
    // handler. After a swap the fresh nav has no flag, so it binds again.
    if (!nav || nav.dataset.navBound === 'true') return;
    nav.dataset.navBound = 'true';
    cleanupScroll?.(); // drop the stale window listener from the previous page
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const panel = document.querySelector<HTMLElement>('#mobile-panel');
    const overlay = document.querySelector<HTMLElement>('[data-overlay]');

    // --- Scroll glass + hide-on-scroll-down / show-on-scroll-up (rAF throttled) ---
    if (nav) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let ticking = false;
      let lastY = window.scrollY;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const y = window.scrollY;
          nav.dataset.scrolled = y > 8 ? 'true' : 'false';
          // Tuck away when scrolling down past the nav; reveal on the way up.
          // Never hide while the mobile menu is open, near the top, or reduced-motion.
          if (!reduce && nav.dataset.menuOpen !== 'true') {
            const goingDown = y > lastY;
            if (goingDown && y > 120) nav.dataset.hidden = 'true';
            else if (!goingDown) nav.dataset.hidden = 'false';
          }
          lastY = y;
          ticking = false;
        });
      };
      onScroll();
      window.addEventListener('scroll', onScroll, { passive: true });
      cleanupScroll = () => window.removeEventListener('scroll', onScroll);
    }

    // --- Mobile panel ---
    if (!(toggle && panel && overlay)) return;
    const focusables = () =>
      Array.from(
        panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
      ).filter((el) => el.offsetParent !== null);

    const open = () => {
      // Keep the bar visible while the menu is open.
      if (nav) { nav.dataset.menuOpen = 'true'; nav.dataset.hidden = 'false'; }
      panel.hidden = false;
      overlay.hidden = false;
      // next frame so the transition runs
      requestAnimationFrame(() => {
        panel.dataset.open = 'true';
      });
      panel.setAttribute('aria-hidden', 'false');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Close menu');
      document.body.style.overflow = 'hidden';
      focusables()[0]?.focus();
      document.addEventListener('keydown', onKeydown);
    };

    const close = () => {
      if (nav) nav.dataset.menuOpen = 'false';
      panel.dataset.open = 'false';
      panel.setAttribute('aria-hidden', 'true');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Open menu');
      document.body.style.overflow = '';
      document.removeEventListener('keydown', onKeydown);
      // Return focus to the trigger.
      toggle.focus();
      // hide after transition so it leaves the tab order
      const hide = () => {
        panel.hidden = true;
        overlay.hidden = true;
      };
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce) hide();
      else window.setTimeout(hide, 300);
    };

    const onKeydown = (e: KeyboardEvent) => {
      if (e.key === 'Escape') {
        close();
        return;
      }
      if (e.key === 'Tab') {
        const items = focusables();
        if (items.length === 0) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };

    toggle.addEventListener('click', () =>
      toggle.getAttribute('aria-expanded') === 'true' ? close() : open(),
    );
    overlay.addEventListener('click', close);
    panel.querySelectorAll('a[href]').forEach((a) => a.addEventListener('click', close));
  }

  // First load (no page-load event when transitions are off) + every swap.
  if (document.readyState !== 'loading') initNav();
  else document.addEventListener('DOMContentLoaded', initNav, { once: true });
  document.addEventListener('astro:page-load', initNav);
</script>
