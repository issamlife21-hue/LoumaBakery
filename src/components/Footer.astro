---
import { siteConfig } from '../config/site';
import { Wordmark } from '../lib/brand';
import FaceDraw from './FaceDraw.astro';
import NewsletterForm from './NewsletterForm.astro';

interface Props {
  /** Show the footer newsletter. Pages with their own signup (home) pass false. */
  newsletter?: boolean;
}
const { newsletter = true } = Astro.props;

const { address, hours, links } = siteConfig;
const year = new Date().getFullYear();

const explore = [
  { label: 'Menu', href: '/menu' },
  { label: 'Our Story', href: '/story' },
  { label: 'Mission', href: '/mission' },
  { label: 'Catering', href: '/catering' },
  { label: 'Careers', href: '/careers' },
  { label: 'Visit', href: '/visit' },
];
---

<footer class="site-foot on-dark">
  <div class="container foot-inner">
    <!-- Newsletter — on every page's footer except those with their own signup. -->
    {newsletter && (
      <div class="foot-newsletter">
        <div class="foot-news">
          <p class="foot-news-h">Get word when we open</p>
          <NewsletterForm variant="footer" />
        </div>
      </div>
    )}

    <div class="foot-cols">
      <!-- Brand -->
      <div class="foot-col foot-brand">
        <FaceDraw class="foot-face" width={104} height={96} color="var(--coral)" />
        <Wordmark class="foot-wordmark" width={180} height={116} aria-label={siteConfig.name} />
        <p class="foot-tag">{siteConfig.tagline}.</p>
      </div>

      <!-- Visit -->
      <div class="foot-col">
        <h2 class="foot-h">Visit</h2>
        <address class="foot-address">
          <p>{address.street}<br />{address.city}, {address.state} {address.zip}</p>
          <ul class="foot-hours" role="list">
            {
              hours.map((h) => (
                <li>
                  <span class="mono">{h.days}</span>
                  <span class="mono foot-hours-time">{h.close ? `${h.open}–${h.close}` : h.open}</span>
                </li>
              ))
            }
          </ul>
          <p class="foot-contact">
            <a href={`tel:${siteConfig.phone.replace(/[^+\d]/g, '')}`}>{siteConfig.phone}</a><br />
            <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          </p>
        </address>
      </div>

      <!-- Explore -->
      <div class="foot-col">
        <h2 class="foot-h">Explore</h2>
        <ul class="foot-links" role="list">
          {explore.map((l) => (<li><a href={l.href}>{l.label}</a></li>))}
          <li><a href={links.instagram} target="_blank" rel="noopener">Instagram</a></li>
          <li><a href={links.paypalDonate} target="_blank" rel="noopener">Support the mission</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-base">
      <p class="mono">© {year} {siteConfig.name}. Opening July 2026.</p>
      <p class="mono">Wilshire · Santa Monica</p>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    background: var(--ink);
    color: color-mix(in srgb, var(--surface-0) 78%, transparent);
    padding-block: var(--space-8) var(--space-6);
    margin-top: var(--space-8);
  }

  .foot-newsletter:empty {
    display: none;
  }
  .foot-newsletter:not(:empty) {
    padding-bottom: var(--space-7);
    margin-bottom: var(--space-7);
    border-bottom: 1px solid color-mix(in srgb, var(--surface-0) 14%, transparent);
  }
  .foot-news { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-4); }
  .foot-news-h {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(20px, 2.4vw, 28px);
    color: var(--surface-0);
  }
  /* Newsletter form/input styling lives in NewsletterForm.astro (scoped to where it renders). */

  .foot-cols {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--space-7);
  }

  .foot-brand .foot-face {
    color: var(--coral);
  }
  .foot-brand .foot-wordmark {
    color: var(--butter);
    margin-top: var(--space-2);
    height: auto;
  }
  .foot-tag {
    margin-top: var(--space-4);
    color: color-mix(in srgb, var(--surface-0) 72%, transparent);
    font-style: italic;
    font-family: var(--font-display);
    font-size: clamp(20px, 2.2vw, 28px);
    line-height: 1.25;
    max-width: 18ch;
  }

  /* Column headers share the site-wide label language: mono tracked + a short
     dash rule (coral on this ink surface). */
  .foot-h {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    font-weight: 500;
    color: color-mix(in srgb, var(--surface-0) 88%, transparent);
    margin-bottom: var(--space-4);
  }
  .foot-h::before {
    content: "";
    width: 1.4em;
    height: 2px;
    border-radius: 1px;
    background: var(--coral);
  }

  .foot-address {
    font-style: normal;
    line-height: 1.7;
  }
  .foot-hours {
    margin: var(--space-3) 0;
    padding: 0;
    font-size: 13px;
  }
  .foot-hours li {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 2px 0;
  }
  .foot-hours-time {
    color: color-mix(in srgb, var(--surface-0) 62%, transparent);
  }

  .foot-links {
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .site-foot a {
    color: color-mix(in srgb, var(--surface-0) 82%, transparent);
    text-decoration: none;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .site-foot a:hover {
    color: var(--coral);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .foot-base {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
    margin-top: var(--space-8);
    padding-top: var(--space-5);
    border-top: 1px solid color-mix(in srgb, var(--surface-0) 14%, transparent);
    font-size: 12px;
    color: color-mix(in srgb, var(--surface-0) 55%, transparent);
  }

  @media (max-width: 760px) {
    .foot-cols {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
</style>
