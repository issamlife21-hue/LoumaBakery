---
import '../styles/global.css';
import { siteConfig, SITE_URL } from '../config/site';
import { features } from '../config/features';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { ClientRouter } from 'astro:transitions';

// Self-hosted fonts (Fontsource, font-display: swap) — bundled and served from
// our own origin so first paint isn't blocked on Google Fonts before the LCP.
import '@fontsource/cormorant-garamond/300.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/300-italic.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '@fontsource/cormorant-sc/500.css';
import '@fontsource/cormorant-sc/600.css';
import '@fontsource/dm-sans/300.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';

interface Props {
  title?: string;
  description?: string;
  /** OG/Twitter image path (absolute or root-relative). */
  image?: string;
  /** schema.org / OG type. */
  ogType?: 'website' | 'article';
  /** Make the nav transparent over a hero (page provides its own hero bg). */
  transparentNav?: boolean;
  /** Keep the page out of search indexes (internal pages). */
  noindex?: boolean;
  /** schema.org structured data: 'bakery' (home), 'localbusiness' (visit), or none. */
  schema?: 'bakery' | 'localbusiness';
  /** Show the footer newsletter. Pages with their own signup (home) pass false. */
  footerNewsletter?: boolean;
}

const {
  title,
  description = siteConfig.tagline,
  image = '/og-default.jpg', // PLACEHOLDER OG image until real art lands
  ogType = 'website',
  transparentNav = false,
  noindex = false,
  schema,
  footerNewsletter = true,
} = Astro.props;

const pageTitle = title ? `${title} · ${siteConfig.name}` : `${siteConfig.name} · ${siteConfig.tagline}`;
const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImage = new URL(image, SITE_URL).href;

// schema.org structured data, assembled from the single config source.
// Bakery on the home page; LocalBusiness (with opening hours) on /visit.
const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: siteConfig.address.street,
  addressLocality: siteConfig.address.city,
  addressRegion: siteConfig.address.state,
  postalCode: siteConfig.address.zip,
  addressCountry: 'US',
};
const dayMap: Record<string, string[]> = {
  'Tuesday – Friday': ['Tuesday', 'Wednesday', 'Thursday', 'Friday'],
  'Saturday – Sunday': ['Saturday', 'Sunday'],
};
const to24 = (t: string) => {
  const m = t.match(/(\d+):(\d+)\s*(AM|PM)/i);
  if (!m) return undefined;
  let h = parseInt(m[1], 10);
  const min = m[2];
  if (/pm/i.test(m[3]) && h !== 12) h += 12;
  if (/am/i.test(m[3]) && h === 12) h = 0;
  return `${String(h).padStart(2, '0')}:${min}`;
};
const openingHours = siteConfig.hours
  .filter((h) => h.close && dayMap[h.days])
  .map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: dayMap[h.days].map((d) => `https://schema.org/${d}`),
    opens: to24(h.open),
    closes: to24(h.close),
  }));

const jsonLd =
  schema === 'localbusiness'
    ? {
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: siteConfig.name,
        description: siteConfig.tagline,
        url: SITE_URL,
        telephone: siteConfig.phone,
        email: siteConfig.email,
        image: ogImage,
        priceRange: '$$',
        address: postalAddress,
        openingHoursSpecification: openingHours,
      }
    : schema === 'bakery'
      ? {
          '@context': 'https://schema.org',
          '@type': 'Bakery',
          name: siteConfig.name,
          description: siteConfig.tagline,
          url: SITE_URL,
          telephone: siteConfig.phone,
          email: siteConfig.email,
          image: ogImage,
          priceRange: '$$',
          address: postalAddress,
        }
      : null;
---

<html
  lang="en"
  class={[
    features.grainTexture && 'grain',
    features.boldDisplay && 'type-bold',
    features.imageTone && 'img-tone',
    features.sketchyLinks && 'links-sketch',
  ].filter(Boolean).join(' ')}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#2A1F18" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Favicons + app icons (generated from face.svg) -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Fonts are self-hosted via Fontsource (imported in the component script). -->

    <!-- schema.org structured data (home: Bakery, visit: LocalBusiness).
         Escape `<` so a value containing </script> can't break out. -->
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} is:inline />}

    {features.pageTransition && <ClientRouter />}

    {/* Pre-paint motion classes: set on <html> before first paint so reveal/
        hero start hidden only when motion will actually run (no FOUC, no
        stuck-hidden content under reduced-motion or when a flag is off). */}
    <script is:inline define:vars={{ flags: features }}>
      (function () {
        var h = document.documentElement;
        h.classList.add('js');
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          h.classList.add('reduced-motion');
          return;
        }
        h.classList.add('motion');
        if (!window.matchMedia('(pointer: coarse)').matches) h.classList.add('fine-pointer');
        if (flags.reveal) h.classList.add('fx-reveal');
        if (flags.lineMask) h.classList.add('fx-lines');
        if (flags.heroRise) h.classList.add('fx-hero');
        if (flags.headlineRise) h.classList.add('fx-headline');
        if (flags.preloader) h.classList.add('fx-preloader');
      })();
    </script>

    <!-- Critical nav/hero CSS, inlined to protect first paint. -->
    <style is:inline>
      :root {
        --nav-h: 72px;
      }
      .skip-link {
        position: absolute;
        left: 1rem;
        top: -3rem;
        z-index: 10000;
        background: var(--burgundy, #6e1f2a);
        color: #fbf5d4;
        padding: 0.6rem 1rem;
        border-radius: 8px;
        transition: top 160ms ease;
      }
      .skip-link:focus {
        top: 1rem;
      }
      .site-nav {
        position: fixed;
        inset-block-start: 0;
        inset-inline: 0;
        z-index: 1000;
        height: var(--nav-h);
        display: flex;
        align-items: center;
      }
      .site-nav[data-transparent='true']:not([data-scrolled='true']) {
        background: transparent;
      }
      .site-nav[data-scrolled='true'],
      .site-nav:not([data-transparent='true']) {
        background: color-mix(in srgb, var(--surface-0, #faf5ea) 78%, transparent);
        -webkit-backdrop-filter: saturate(140%) blur(12px);
        backdrop-filter: saturate(140%) blur(12px);
        box-shadow: 0 1px 0 color-mix(in srgb, #2a1f18 8%, transparent);
      }
      /* Reserve nav height on non-hero pages so content isn't hidden. */
      body:not([data-hero='true']) {
        padding-top: var(--nav-h);
      }
    </style>
  </head>

  <body data-hero={transparentNav ? 'true' : 'false'}>
    {/* Preloader — shown only when html.fx-preloader; JS fades it out. */}
    <div id="preloader" aria-hidden="true">
      <span class="preloader-mark">Louma</span>
    </div>

    <a class="skip-link" href="#main">Skip to content</a>
    <Nav transparent={transparentNav} />
    <main id="main">
      <slot />
    </main>
    <Footer newsletter={footerNewsletter} />

    <script>
      import '../scripts/motion.ts';
      import '../scripts/forms.ts';
    </script>
  </body>
</html>
