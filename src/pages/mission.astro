---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { features as f } from '../config/features';

const c = (await getEntry('copy', 'mission'))!.data;
const values = c.values ?? [];
const stats = c.stats ?? [];
---

<BaseLayout title="Mission" description={c.lede}>
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      {c.lede && <p class="lede">{c.lede}</p>}
    </div>
  </header>

  {/* Statement */}
  <section class="statement" data-anim={f.reveal ? 'reveal' : undefined}>
    <div class="container narrow">
      {c.body.map((p) => <p class="statement-p">{p}</p>)}
    </div>
  </section>

  {/* Values */}
  {values.length > 0 && (
    <section class="values">
      <div class="container">
        <ul class="values-grid" role="list" data-anim={f.reveal ? 'reveal' : undefined} data-reveal-children>
          {values.map((v) => (
            <li class="value-card" data-fx-lift={f.hoverLift ? '' : undefined}>
              {/* Numbered markers removed by request; could return later as
                  small custom drawn-numeral images. */}
              <h2 class="value-title">{v.title}</h2>
              <p>{v.body}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* Count-up stats */}
  {stats.length > 0 && (
    <section class="stats" aria-label="By the numbers" data-anim={f.countUp ? 'count-up' : undefined}>
      <div class="container stats-grid">
        {stats.map((s) => (
          <div class="stat">
            <span class="stat-value mono" data-countup={s.value} data-suffix={s.suffix ?? ''} data-prefix={s.prefix ?? ''}>
              {s.prefix ?? ''}{s.value}{s.suffix ?? ''}
            </span>
            <span class="stat-label">{s.label}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  {/* Donate */}
  <section class="donate on-dark" data-anim={f.reveal ? 'reveal' : undefined}>
    <div class="container donate-inner">
      <div>
        <p class="eyebrow">Give</p>
        <h2 class="donate-title">{c.donateTitle ?? c.cta?.label}</h2>
        {c.donateBody && <p class="donate-body">{c.donateBody}</p>}
      </div>
      <a class="btn btn-coral" href={siteConfig.links.paypalDonate} target="_blank" rel="noopener" data-fx-magnetic={f.magneticButtons ? '' : undefined}>
        {c.cta?.label ?? 'Donate'}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .narrow { max-width: 720px; }
  .statement { padding-block: var(--space-8); }
  .statement-p { font-size: clamp(20px, 2vw, 26px); font-family: var(--font-display); color: var(--ink); line-height: 1.4; }
  .statement-p + .statement-p { margin-top: var(--space-4); }

  .values { padding-block: var(--space-7) var(--space-9); }
  .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }
  .value-card {
    padding: var(--space-6);
    background: var(--surface-1);
    border-radius: var(--radius-lg);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }
  .value-title { margin-bottom: var(--space-2); font-size: 24px; }

  .stats { padding-block: var(--space-8); background: var(--surface-2); }
  .stats-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-6); text-align: center; max-width: 760px; margin-inline: auto; }
  .stat-value { display: block; font-size: clamp(40px, 6vw, 72px); color: var(--burgundy); line-height: 1; }
  .stat-label { display: block; margin-top: var(--space-3); color: var(--body); font-size: 15px; }

  .donate { background: var(--ink); color: var(--surface-0); padding-block: var(--space-8); }
  .donate-inner { display: flex; align-items: center; justify-content: space-between; gap: var(--space-6); flex-wrap: wrap; }
  .donate-title { color: var(--surface-0); margin-top: var(--space-2); }
  .donate-body { margin-top: var(--space-3); color: color-mix(in srgb, var(--surface-0) 78%, transparent); max-width: 46ch; }

  @media (max-width: 820px) {
    .values-grid { grid-template-columns: 1fr; }
    .stats-grid { grid-template-columns: 1fr; gap: var(--space-7); }
  }
</style>
