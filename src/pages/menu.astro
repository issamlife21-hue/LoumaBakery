---
import { getEntry, getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { features as f, layoutSystem } from '../config/features';
import Sketch from '../components/Sketch.astro';
import { resolveImage } from '../lib/images';

const c = (await getEntry('copy', 'menu'))!.data;
const menu = (await getCollection('menu')).sort((a, b) => a.data.order - b.data.order);

// Optimized image URLs per item: a small inline thumb (mobile rows) and a
// larger panel image (the desktop floating photo panel).
const thumbs: Record<string, string> = {};
const panels: Record<string, string> = {};
for (const cat of menu) {
  for (const item of cat.data.items) {
    const meta = resolveImage(item.image);
    if (meta) {
      thumbs[item.name] = (await getImage({ src: meta, width: 320, format: 'webp' })).src;
      panels[item.name] = (await getImage({ src: meta, width: 720, format: 'webp' })).src;
    }
  }
}
const firstPanel = Object.values(panels)[0];
---

<BaseLayout title="Menu" description={c.lede}>
  <header class="page-head menu-head">
    <div class="container">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      {c.lede && <p class="lede">{c.lede}</p>}
      <Sketch name="baguette" width={150} height={54} class="head-sketch" color="var(--clay)" draw={f.scrollDraw} />
    </div>
  </header>

  {/* Sticky category pill nav (progressive: plain anchors; scroll-spy is JS-enhanced) */}
  <nav class="pillnav" aria-label="Menu categories">
    <ul class="pillnav-track container" role="list">
      {menu.map((cat) => (
        <li>
          <a class="pill" href={`#menu-${cat.id}`} data-spy={`menu-${cat.id}`}>{cat.data.title}</a>
        </li>
      ))}
    </ul>
  </nav>

  <div class="container menu-body">
    {menu.map((cat) => (
      <section class="menu-cat" id={`menu-${cat.id}`} aria-labelledby={`h-${cat.id}`} data-anim={f.reveal ? 'reveal' : undefined}>
        <h2 class="menu-cat-title smallcaps" id={`h-${cat.id}`}>{cat.data.title}</h2>
        <ul class="menu-rows" role="list">
          {cat.data.items.map((item) => (
            <li class="menu-row" data-menu-hover={f.menuHover ? '' : undefined} data-img={panels[item.name] || undefined}>
              <div class="row-main">
                {panels[item.name] ? (
                  <button
                    type="button"
                    class="row-toggle"
                    aria-expanded="false"
                    aria-controls={`x-${cat.id}-${item.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}
                  >
                    <span class="row-head">
                      <span class="row-name">{item.name}</span>
                      <span class="row-dots" aria-hidden="true"></span>
                      <span class="row-price mono">{item.price}</span>
                    </span>
                  </button>
                ) : (
                  <div class="row-head">
                    <h3 class="row-name">{item.name}</h3>
                    <span class="row-dots" aria-hidden="true"></span>
                    <span class="row-price mono">{item.price}</span>
                  </div>
                )}
                {item.description && <p class="row-desc">{item.description}</p>}
                {item.tags.length > 0 && (
                  <ul class="product-tags" role="list">
                    {item.tags.map((t) => <li class="tag mono">{t}</li>)}
                  </ul>
                )}
                {panels[item.name] && (
                  <div class="row-expand" id={`x-${cat.id}-${item.name.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>
                    <div class="row-expand-inner">
                      <img
                        class="row-expand-img"
                        src={panels[item.name]}
                        alt={item.name}
                        width="720"
                        height="540"
                        loading="lazy"
                        decoding="async"
                        sizes="(max-width: 430px) 86vw, 360px"
                      />
                    </div>
                  </div>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {layoutSystem === 'slab' && firstPanel && (
      <aside class="menu-panel" aria-hidden="true">
        <img class="menu-panel-img is-a" src={firstPanel} alt="" width="720" height="540" loading="lazy" decoding="async" />
        <img class="menu-panel-img is-b" src={firstPanel} alt="" width="720" height="540" loading="lazy" decoding="async" />
      </aside>
    )}

    {c.allergenNote && (
      <aside class="allergen" aria-label="Allergens">
        <p class="eyebrow">Allergens</p>
        <p>{c.allergenNote}</p>
      </aside>
    )}
  </div>
</BaseLayout>

<style>
  .pillnav {
    position: sticky;
    top: var(--nav-h);
    z-index: 500;
    background: color-mix(in srgb, var(--surface-0) 88%, transparent);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    border-block: 1px solid var(--hairline);
  }
  .pillnav-track {
    display: flex;
    gap: var(--space-2);
    overflow-x: auto;
    padding-block: var(--space-3);
    scrollbar-width: none;
  }
  .pillnav-track::-webkit-scrollbar { display: none; }
  .pill {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1.1rem;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    color: var(--body);
    font-family: var(--font-mono);
    font-size: 13px;
    text-decoration: none;
    white-space: nowrap;
    transition: background var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .pill:hover { background: var(--surface-3); }
  }
  .pill { min-width: 44px; }
  /* Native momentum + snap on the pill rail. */
  .pillnav-track { scroll-snap-type: x proximity; }
  .pill { scroll-snap-align: start; flex: 0 0 auto; }
  .pill[aria-current='true'] { background: var(--burgundy); color: var(--butter); }

  .menu-body { padding-block: var(--space-7) var(--space-9); }
  .menu-cat { padding-top: var(--space-6); scroll-margin-top: calc(var(--nav-h) + 64px); }
  .menu-cat-title { font-size: clamp(24px, 3vw, 34px); color: var(--clay); margin-bottom: var(--space-5); }

  .menu-rows { display: flex; flex-direction: column; }
  .menu-row {
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--hairline);
  }
  .row-head { display: flex; align-items: baseline; gap: var(--space-3); }
  .row-name { font-family: var(--font-display); font-weight: 500; font-size: 22px; color: var(--ink); display: inline-block; }
  /* Tactile row hover (menuHover flag): the dish name leans in, price warms. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .menu-row[data-menu-hover] .row-name,
    .menu-row[data-menu-hover] .row-price { transition: transform var(--dur) var(--ease-out), color var(--dur) var(--ease-out); }
    .menu-row[data-menu-hover]:hover .row-name { transform: translateX(8px); color: var(--burgundy); }
    .menu-row[data-menu-hover]:hover .row-price { color: var(--red); }
  }
  .row-dots { flex: 1; border-bottom: 1px dotted color-mix(in srgb, var(--ink) 28%, transparent); transform: translateY(-4px); }
  .row-price { color: var(--burgundy); font-size: 16px; }
  .row-desc { margin-top: var(--space-2); color: var(--muted); max-width: 60ch; }
  /* .tag chip style is global (one badge language site-wide). */
  .product-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-3); }

  .allergen {
    margin-top: var(--space-8);
    padding: var(--space-5);
    background: var(--surface-2);
    border-radius: var(--radius-lg);
    max-width: 70ch;
  }
  .allergen p:last-child { margin-top: var(--space-2); color: var(--body); }

  /* --- Row toggle button (photo rows): plain, full-width, 44px target --- */
  .row-toggle {
    display: block;
    width: 100%;
    min-height: 44px;
    padding: 2px 0;
    background: none;
    border: 0;
    text-align: start;
    font: inherit;
    color: inherit;
  }
  .row-toggle .row-head { width: 100%; }
  /* Tap-to-expand area (touch): grid-rows 0fr->1fr, settles downward. */
  .row-expand {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 320ms var(--ease-out);
  }
  .row-expand-inner { overflow: hidden; min-height: 0; }
  .row-expand-img {
    width: min(100%, 360px);
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--hairline-strong);
    margin-top: var(--space-3);
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }
  .menu-row.is-open .row-expand { grid-template-rows: 1fr; }
  @media (prefers-reduced-motion: reduce) {
    .row-expand { transition: none; }
  }
  /* Desktop (hover devices): the floating panel is the photo surface; the
     inline expand stays shut and the toggle acts as the focus target only. */
  @media (hover: hover) and (pointer: fine) {
    .row-expand { display: none; }
  }
  /* Touch devices never get the floating panel (no listeners bound either). */
  @media (hover: none), (pointer: coarse) {
    .menu-panel { display: none !important; }
  }

  /* --- Slab: typographic list + floating photo panel --- */
  :global(html.sys-slab) .menu-body { max-width: none; }
  :global(html.sys-slab) .menu-cat { max-width: 720px; }
  :global(html.sys-slab) .row-name { font-size: clamp(26px, 2.8vw, 34px); font-weight: 400; }
  .menu-panel { display: none; }
  @media (min-width: 1024px) {
    :global(html.sys-slab) .menu-panel {
      display: block;
      position: fixed;
      top: calc(var(--nav-h) + 96px);
      inset-inline-end: clamp(1rem, 4vw, 4rem);
      width: min(30vw, 420px);
      aspect-ratio: 4 / 3;
      border-radius: 16px;
      border: 1px solid var(--hairline-strong);
      overflow: hidden;
      background: var(--butter);
      opacity: 0;
      transition: opacity 240ms var(--ease-out);
      pointer-events: none;
      z-index: 40;
    }
    :global(html.sys-slab) .menu-panel.is-on { opacity: 1; }
    .menu-panel-img {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
      transition: opacity 240ms var(--ease-out);
    }
    .menu-panel-img.is-front { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu-panel, .menu-panel-img { transition: none; }
  }

  /* Hand-drawn baguette tucked into the header corner. */
  .menu-head { position: relative; overflow: hidden; }
  .menu-head .container { position: relative; }
  /* :global — the class lands on the Sketch CHILD component's svg, which a
     page-scoped selector cannot reach. */
  .menu-head :global(.head-sketch) {
    position: absolute;
    inset-inline-end: 0;
    inset-block-end: 0;
    width: clamp(100px, 11vw, 150px);
    height: auto;
  }
  @media (max-width: 680px) {
    .menu-head :global(.head-sketch) { position: static; margin-top: var(--space-5); width: 110px; }
  }
</style>

<script>
  // Floating photo panel: HOVER DEVICES ONLY (mouse + keyboard focus). On
  // touch the panel is display:none and no listeners are bound at all.
  const hoverFine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const panel = document.querySelector<HTMLElement>('.menu-panel');
  if (panel && hoverFine) {
    const imgs = Array.from(panel.querySelectorAll<HTMLImageElement>('.menu-panel-img'));
    let front = 0;
    let current = '';
    imgs[0]?.classList.add('is-front');
    const show = (src: string | undefined) => {
      if (!src) { panel.classList.remove('is-on'); return; }
      panel.classList.add('is-on');
      if (src === current) return;
      current = src;
      const back = 1 - front;
      imgs[back].src = src;
      imgs[back].classList.add('is-front');
      imgs[front].classList.remove('is-front');
      front = back;
    };
    document.querySelectorAll<HTMLElement>('.menu-row[data-img]').forEach((row) => {
      row.addEventListener('mouseenter', () => show(row.dataset.img));
      row.addEventListener('focusin', () => show(row.dataset.img));
    });
    const list = document.querySelector('.menu-body');
    list?.addEventListener('mouseleave', () => panel.classList.remove('is-on'));
  }

  // Tap-to-expand (touch devices): one open at a time; button carries
  // aria-expanded; the area settles open downward via grid-rows.
  if (!hoverFine) {
    let open: HTMLElement | null = null;
    document.querySelectorAll<HTMLButtonElement>('.row-toggle').forEach((btn) => {
      btn.addEventListener('click', () => {
        const row = btn.closest<HTMLElement>('.menu-row');
        if (!row) return;
        const wasOpen = row.classList.contains('is-open');
        if (open && open !== row) {
          open.classList.remove('is-open');
          open.querySelector('.row-toggle')?.setAttribute('aria-expanded', 'false');
        }
        row.classList.toggle('is-open', !wasOpen);
        btn.setAttribute('aria-expanded', String(!wasOpen));
        open = wasOpen ? null : row;
      });
    });
  }
</script>

<script>
  // Scroll-spy: highlight the pill for the section in view. Progressive —
  // anchors already work; this only adds aria-current. Throttled by IO.
  const pills = Array.from(document.querySelectorAll<HTMLAnchorElement>('.pill[data-spy]'));
  const byId = new Map(pills.map((p) => [p.dataset.spy!, p]));
  const sections = pills.map((p) => document.getElementById(p.dataset.spy!)).filter(Boolean) as HTMLElement[];

  if ('IntersectionObserver' in window && sections.length) {
    const setActive = (id: string) => {
      pills.forEach((p) => p.removeAttribute('aria-current'));
      const active = byId.get(id);
      active?.setAttribute('aria-current', 'true');
      // Keep the active pill visible in the rail.
      active?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'smooth' });
    };
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((e) => e.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (visible) setActive(visible.target.id);
      },
      { rootMargin: '-45% 0px -50% 0px', threshold: 0 },
    );
    sections.forEach((s) => io.observe(s));
  }
</script>
