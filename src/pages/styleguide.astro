---
import "../styles/global.css";
import { features } from "../config/features";
import { Face, Wordmark, Baguette, Toast } from "../lib/brand";

// Temporary design-system reference page. Not linked from anywhere.
// Removed/replaced once real pages exist.

const colorGroups = [
  {
    title: "Brand / accent",
    note: "Red is accent only — max ~3 per page. Burgundy is the workhorse.",
    swatches: [
      { name: "red", token: "--red", hex: "#ED2739", dark: true },
      { name: "burgundy", token: "--burgundy", hex: "#6E1F2A", dark: true },
      { name: "clay", token: "--clay", hex: "#B8533F", dark: true },
      { name: "amber-warm", token: "--amber-warm", hex: "#C8853A", dark: true },
      { name: "coral", token: "--coral", hex: "#EF6E78", dark: false },
      { name: "navy-stitch", token: "--navy-stitch", hex: "#2B3A55", dark: true },
    ],
  },
  {
    title: "Text",
    swatches: [
      { name: "ink", token: "--ink", hex: "#2A1F18", dark: true },
      { name: "body", token: "--body", hex: "#4A3D34", dark: true },
      { name: "muted", token: "--muted", hex: "#7A6E62", dark: true },
    ],
  },
  {
    title: "Surfaces",
    swatches: [
      { name: "surface-0", token: "--surface-0", hex: "#FAF5EA", dark: false },
      { name: "surface-1", token: "--surface-1", hex: "#F5EDD8", dark: false },
      { name: "surface-2", token: "--surface-2", hex: "#EFE2C4", dark: false },
      { name: "surface-3", token: "--surface-3", hex: "#E8D4AA", dark: false },
      { name: "butter", token: "--butter", hex: "#FBF5D4", dark: false },
    ],
  },
];

const typeScale = [
  { label: "Hero — Cormorant Garamond 300 italic", cls: "spec-hero", text: "Out of the oven by eight" },
  { label: "H1 — Cormorant Garamond 500", cls: "spec-h1", text: "A neighborhood bakery" },
  { label: "H2 — Cormorant Garamond 500", cls: "spec-h2", text: "Bread, and the people who make it" },
  { label: "H3 — Cormorant Garamond 500", cls: "spec-h3", text: "Loaves, pastries, the morning bake" },
  { label: "Body — DM Sans 300", cls: "spec-body", text: "Milla named the bakery for her sister Louma. Many of the people who work here have intellectual or developmental differences — the bakery exists partly to show that, done right, that is a strength." },
  { label: "Eyebrow — DM Mono 10px / 0.24em", cls: "eyebrow", text: "Open Tuesday–Sunday" },
  { label: "Small caps — Cormorant SC", cls: "smallcaps", text: "Wilshire · Santa Monica" },
  { label: "Mono — DM Mono (prices / times)", cls: "mono", text: "$4.50 · 7:00 AM" },
];
---

<html lang="en" class={features.grainTexture ? "grain" : ""}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,500;0,600;1,300;1,500&family=Cormorant+SC:wght@500;600&family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500&display=swap"
    />
    <title>Style guide · Louma Bakery</title>
    <meta name="generator" content={Astro.generator} />
  </head>

  <body>
    <header class="container sg-head">
      <p class="eyebrow">Internal · design system</p>
      <h1>Louma style guide</h1>
      <p>
        Tokens, type, and brand marks. Temporary reference — flag
        <code class="mono">grainTexture</code> is
        <strong>{features.grainTexture ? "on" : "off"}</strong>.
      </p>
    </header>

    <!-- ============================================== Color ========= -->
    <section class="container sg-section" aria-labelledby="sg-color">
      <p class="eyebrow">01 — Palette</p>
      <h2 id="sg-color">Color</h2>
      {
        colorGroups.map((group) => (
          <div class="sg-group">
            <h3>{group.title}</h3>
            {group.note && <p class="sg-note">{group.note}</p>}
            <ul class="swatches" role="list">
              {group.swatches.map((s) => (
                <li class="swatch">
                  <span
                    class={`swatch-chip ${s.dark ? "is-dark" : "is-light"}`}
                    style={`background: var(${s.token})`}
                  />
                  <span class="swatch-meta">
                    <span class="mono swatch-name">{s.name}</span>
                    <span class="mono swatch-hex">{s.hex}</span>
                  </span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </section>

    <!-- ============================================== Type ========== -->
    <section class="container sg-section" aria-labelledby="sg-type">
      <p class="eyebrow">02 — Typography</p>
      <h2 id="sg-type">Type scale</h2>
      <div class="sg-type-list">
        {
          typeScale.map((row) => (
            <div class="sg-type-row">
              <p class="eyebrow sg-type-label">{row.label}</p>
              <p class={row.cls}>{row.text}</p>
            </div>
          ))
        }
      </div>
    </section>

    <!-- ============================================== Marks ========= -->
    <section class="container sg-section" aria-labelledby="sg-marks">
      <p class="eyebrow">03 — Brand marks</p>
      <h2 id="sg-marks">Assets</h2>

      <div class="sg-group">
        <h3>Filled line-art — static</h3>
        <p class="sg-note">Face (favicon / footer / 404 / ornament) and the hand-lettered wordmark.</p>
        <div class="mark-grid">
          <figure class="mark-card">
            <Face class="mark mark-face" width={120} height={111} aria-label="Louma face mark" />
            <figcaption class="mono">face.svg · 286×265</figcaption>
          </figure>
          <figure class="mark-card mark-card--wide">
            <Wordmark class="mark mark-wordmark" width={300} height={193} aria-label="Louma Bakery wordmark" />
            <figcaption class="mono">wordmark.svg · 374×240</figcaption>
          </figure>
        </div>
      </div>

      <div class="sg-group">
        <h3>Single-stroke sketches — recolor test</h3>
        <p class="sg-note">
          Same markup on light and dark. Light: brand red (default
          <code class="mono">currentColor</code>). Dark: butter / coral via CSS
          <code class="mono">color</code>. These wire to the scroll-draw in Phase 2.
        </p>
        <div class="recolor-grid">
          <!-- Light -->
          <div class="panel panel-light">
            <p class="eyebrow">On cream — red</p>
            <Baguette class="mark sketch" width={220} height={79} aria-label="Baguette sketch" />
            <Toast class="mark sketch" width={120} height={139} aria-label="Bread slice sketch" />
          </div>
          <!-- Dark -->
          <div class="panel panel-dark on-dark">
            <p class="eyebrow">On navy — butter &amp; coral</p>
            <Baguette class="mark sketch sketch-butter" width={220} height={79} aria-label="Baguette sketch, cream" />
            <Toast class="mark sketch sketch-coral" width={120} height={139} aria-label="Bread slice sketch, coral" />
          </div>
        </div>
      </div>
    </section>

    <footer class="container sg-foot">
      <Face class="mark" width={44} height={41} aria-label="" />
      <p class="mono">Louma Bakery — design system · Phase 1</p>
    </footer>

    <style>
      .sg-head {
        padding-top: var(--space-9);
        padding-bottom: var(--space-6);
      }
      .sg-head h1 {
        margin-top: var(--space-2);
      }
      .sg-head p:last-child {
        margin-top: var(--space-3);
        color: var(--muted);
      }

      .sg-section {
        padding-block: var(--space-7);
        border-top: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
      }
      .sg-section > h2 {
        margin-top: var(--space-2);
        margin-bottom: var(--space-6);
      }

      .sg-group {
        margin-top: var(--space-6);
      }
      .sg-group h3 {
        margin-bottom: var(--space-2);
      }
      .sg-note {
        color: var(--muted);
        font-size: var(--t-small);
        margin-bottom: var(--space-4);
      }

      code {
        font-family: var(--font-mono);
        font-size: 0.85em;
        background: var(--surface-2);
        padding: 0.1em 0.4em;
        border-radius: var(--radius-sm);
      }

      /* --- Swatches --- */
      .swatches {
        list-style: none;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
        gap: var(--space-4);
      }
      .swatch {
        display: flex;
        flex-direction: column;
        gap: var(--space-2);
      }
      .swatch-chip {
        aspect-ratio: 8 / 5;
        border-radius: var(--radius-md);
        box-shadow: var(--shadow-sm);
      }
      .swatch-chip.is-light {
        border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
      }
      .swatch-meta {
        display: flex;
        justify-content: space-between;
        gap: var(--space-2);
        font-size: var(--t-small);
      }
      .swatch-name {
        color: var(--ink);
      }
      .swatch-hex {
        color: var(--muted);
        text-transform: uppercase;
      }

      /* --- Type scale --- */
      .sg-type-list {
        display: flex;
        flex-direction: column;
        gap: var(--space-5);
      }
      .sg-type-row {
        display: grid;
        grid-template-columns: 220px 1fr;
        gap: var(--space-5);
        align-items: baseline;
        padding-bottom: var(--space-5);
        border-bottom: 1px solid color-mix(in srgb, var(--ink) 8%, transparent);
      }
      .sg-type-label {
        padding-top: 0.5em;
      }
      .spec-hero {
        font-family: var(--font-display);
        font-weight: 300;
        font-style: italic;
        font-size: var(--t-hero);
        line-height: var(--lh-tight);
        color: var(--ink);
      }
      .spec-h1 { font-family: var(--font-display); font-weight: 500; font-size: var(--t-h1); color: var(--ink); line-height: var(--lh-tight); }
      .spec-h2 { font-family: var(--font-display); font-weight: 500; font-size: var(--t-h2); color: var(--ink); }
      .spec-h3 { font-family: var(--font-display); font-weight: 500; font-size: var(--t-h3); color: var(--ink); }
      .spec-body { font-family: var(--font-body); font-weight: 300; font-size: var(--t-body); color: var(--body); }

      @media (max-width: 640px) {
        .sg-type-row {
          grid-template-columns: 1fr;
          gap: var(--space-2);
        }
        .sg-type-label {
          padding-top: 0;
        }
      }

      /* --- Marks --- */
      .mark-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: var(--space-4);
      }
      .mark-card {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--space-4);
        padding: var(--space-6);
        background: var(--surface-1);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
      }
      .mark-card figcaption {
        font-size: var(--t-small);
        color: var(--muted);
      }
      .mark {
        color: var(--red); /* default brand red via currentColor */
        height: auto;
      }
      .mark-wordmark {
        width: min(300px, 100%);
      }

      /* --- Recolor test --- */
      .recolor-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--space-4);
      }
      @media (max-width: 640px) {
        .recolor-grid {
          grid-template-columns: 1fr;
        }
      }
      .panel {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: var(--space-6);
        padding: var(--space-7) var(--space-6);
        border-radius: var(--radius-lg);
      }
      .panel .eyebrow {
        flex-basis: 100%;
      }
      .panel-light {
        background: var(--surface-2);
      }
      .panel-dark {
        background: var(--navy-stitch);
      }
      .panel-dark .eyebrow {
        color: color-mix(in srgb, var(--butter) 70%, transparent);
      }
      .sketch { color: var(--red); }
      .sketch-butter { color: var(--butter); }
      .sketch-coral { color: var(--coral); }

      /* --- Footer --- */
      .sg-foot {
        display: flex;
        align-items: center;
        gap: var(--space-4);
        padding-block: var(--space-8) var(--space-9);
        margin-top: var(--space-6);
        border-top: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
        color: var(--muted);
      }
      .sg-foot .mark {
        color: var(--burgundy);
      }
    </style>
  </body>
</html>
