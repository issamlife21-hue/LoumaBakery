---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { features as f, heroStyle } from '../config/features';
import Img from '../components/Img.astro';
import Sketch from '../components/Sketch.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import { resolveImage as pick } from '../lib/images';
import images from '../data/images.json';
import heroFallback from '../assets/placeholders/hero.jpg';
import featureImg from '../assets/placeholders/feature.jpg';
import landscapeImg from '../assets/placeholders/landscape.jpg';
import portraitImg from '../assets/placeholders/portrait.jpg';
import squareImg from '../assets/placeholders/square.jpg';

const heroPhoto = pick(images.hero) ?? heroFallback;

// --- All content pulled from collections / config. No hardcoded copy. ---
const home = (await getEntry('copy', 'home'))!.data;
const menu = (await getCollection('menu')).sort((a, b) => a.data.order - b.data.order);
const marquee = (await getCollection('marquee')).sort((a, b) => a.data.order - b.data.order);
const chapters = (await getCollection('storyChapters')).sort((a, b) => a.data.order - b.data.order);
const testimonials = await getCollection('testimonials');

const lead = testimonials[0]?.data;
const altBlocks = chapters.slice(0, 3);

// Order link is a placeholder until a real Uber Eats URL is set — render the
// button inert ("Ordering soon") rather than a dead link. Becomes a real link
// the moment a non-default URL lands in settings.
const orderReady = !!siteConfig.links.uberEats && siteConfig.links.uberEats !== 'https://www.ubereats.com/';
---

<BaseLayout transparentNav={heroStyle === 'photo'} schema="bakery" footerNewsletter={false}>
  {/* ============================================ 1 · HERO ========= */}
  {heroStyle === 'photo' ? (
    <section class="hero">
      <Img src={heroPhoto} alt="" class="hero-bg" anim={f.kenBurns ? 'ken-burns' : undefined} priority sizes="100vw" />
      {siteConfig.links.heroVideo && (
        <video class="hero-video" data-hero-video={siteConfig.links.heroVideo} autoplay muted loop playsinline aria-hidden="true">
          <source src={siteConfig.links.heroVideo} />
        </video>
      )}
      <div class="hero-overlay" aria-hidden="true"></div>
      <div class="container hero-grid">
        <div class="hero-panel">
          <p class="eyebrow hero-eyebrow" data-anim={f.typewriter ? 'typewriter' : undefined}>{home.eyebrow}</p>
          <h1 class="hero-headline" data-anim={f.weightBreath ? 'weight-breath' : undefined}>{home.title}</h1>
          {home.lede && <p class="hero-lede">{home.lede}</p>}
          {orderReady ? (
            <a class="btn btn-primary hero-cta" href={siteConfig.links.uberEats} target="_blank" rel="noopener" data-fx-magnetic={f.magneticButtons ? '' : undefined}>
              {home.cta?.label ?? 'Order'}
            </a>
          ) : (
            <button class="btn btn-primary hero-cta" type="button" disabled aria-disabled="true" title="Online ordering opens with the bakery.">
              Ordering soon
            </button>
          )}
        </div>
      </div>
    </section>
  ) : (
    <section class="hero-ed">
      <div class="container hero-ed-grid">
        <div class="hero-ed-text">
          <p class="eyebrow" data-anim={f.typewriter ? 'typewriter' : undefined}>{home.eyebrow}</p>
          <h1 class="hero-headline hero-ed-headline" data-anim={f.weightBreath ? 'weight-breath' : undefined}>{home.title}</h1>
          {home.lede && <p class="hero-ed-lede">{home.lede}</p>}
          {orderReady ? (
            <a class="btn btn-primary hero-ed-cta" href={siteConfig.links.uberEats} target="_blank" rel="noopener" data-fx-magnetic={f.magneticButtons ? '' : undefined}>
              {home.cta?.label ?? 'Order'}
            </a>
          ) : (
            <button class="btn btn-primary hero-ed-cta" type="button" disabled aria-disabled="true" title="Online ordering opens with the bakery.">
              Ordering soon
            </button>
          )}
          <div class="hero-ed-sketch" aria-hidden="true">
            <Sketch name="baguette" width={240} height={86} color="var(--red)" draw={f.scrollDraw} />
          </div>
        </div>
        <div class="hero-ed-media">
          <Img src={heroPhoto} alt="" class="hero-ed-photo" anim={f.kenBurns ? 'ken-burns' : undefined} priority sizes="(max-width: 860px) 100vw, 46vw" />
        </div>
      </div>
    </section>
  )}

  {/* ====================================== 2 · EDITORIAL (thesis) = */}
  <section class="editorial section" data-anim={f.reveal ? 'reveal' : undefined}>
    <div class="editorial-inner">
      <h2 class="editorial-line">{home.craftLine}</h2>
      {home.body.map((p) => <p class="editorial-body">{p}</p>)}
      {home.missionLine && <p class="editorial-mission">{home.missionLine}</p>}
      <div class="home-break" aria-hidden="true">
        <Sketch name="baguette" width={200} height={71} color="var(--clay)" draw={f.scrollDraw} />
      </div>
    </div>
  </section>

  {/* ==================================== 3 · SIGNATURE (full-bleed) */}
  {altBlocks[0] && (
    <section class="block block--fullbleed" data-anim={f.parallax ? 'parallax' : undefined}>
      <Img src={pick(images.story1) ?? featureImg} alt="" class="block-bg" anim={f.kenBurns ? 'ken-burns' : undefined} sizes="100vw" />
      <div class="block-overlay" aria-hidden="true"></div>
      <div class="container block-fb-text on-dark">
        {altBlocks[0].data.eyebrow && <p class="eyebrow">{altBlocks[0].data.eyebrow}</p>}
        <h2>{altBlocks[0].data.title}</h2>
        <p>{altBlocks[0].data.body}</p>
      </div>
    </section>
  )}

  {/* ==================================== 4 · NUMERAL block ======== */}
  {altBlocks[1] && (
    <section class="block block--numeral section" data-anim={f.reveal ? 'reveal' : undefined}>
      <div class="container block-numeral-grid">
        <div class="block-numeral-text">
          <span class="big-numeral" aria-hidden="true">{altBlocks[1].data.eyebrow ?? '02'}</span>
          <h2>{altBlocks[1].data.title}</h2>
          <p>{altBlocks[1].data.body}</p>
        </div>
        <Img src={pick(images.story2) ?? portraitImg} alt={altBlocks[1].data.title} class="block-numeral-img" tilt={f.imageTilt} sizes="(max-width: 860px) 100vw, 45vw" />
      </div>
    </section>
  )}

  {/* ==================================== 5 · DUO block =========== */}
  {altBlocks[2] && (
    <section class="block block--duo section" data-anim={f.reveal ? 'reveal' : undefined}>
      <div class="container block-duo-grid">
        <div class="block-duo-imgs">
          <Img src={pick(images.story3) ?? portraitImg} alt={altBlocks[2].data.title} class="duo-img duo-img--1" tilt={f.imageTilt} sizes="(max-width: 860px) 50vw, 30vw" />
          <Img src={pick(images.ig1) ?? squareImg} alt="" class="duo-img duo-img--2" tilt={f.imageTilt} sizes="(max-width: 860px) 50vw, 30vw" />
        </div>
        <div class="block-duo-text">
          {altBlocks[2].data.eyebrow && <p class="eyebrow">{altBlocks[2].data.eyebrow}</p>}
          <h2>{altBlocks[2].data.title}</h2>
          <p>{altBlocks[2].data.body}</p>
        </div>
      </div>
    </section>
  )}

  {/* ======================================= 6 · MARQUEE (accent) = */}
  <section class="marquee" aria-label="Louma in a few words" data-anim={f.marquee ? 'marquee' : undefined}>
    <div class="marquee-track">
      {marquee.map((m) => (
        <span class="marquee-item">
          <span>{m.data.text}</span>
          <span class="marquee-dot" aria-hidden="true">·</span>
        </span>
      ))}
    </div>
  </section>

  {/* Section break ornament */}
  <div class="home-break home-break--toast container" aria-hidden="true">
    <Sketch name="toast" width={84} height={97} color="var(--clay)" draw={f.scrollDraw} />
  </div>

  {/* =================================== 7 · PRODUCT GRID ========= */}
  <section class="menu-sec section" data-anim={f.reveal ? 'reveal' : undefined}>
    <div class="container">
      <header class="sec-head">
        <p class="eyebrow">The menu</p>
        <h2>{home.menuTitle}</h2>
      </header>
      {menu.map((cat) => (
        <div class="menu-cat">
          <h3 class="menu-cat-title smallcaps">{cat.data.title}</h3>
          <ul class="product-grid" role="list">
            {cat.data.items.map((item) => (
              <li class="product-card" data-fx-tilt={f.cardTilt ? '' : undefined} data-fx-lift={f.hoverLift ? '' : undefined}>
                <Img src={pick(item.image) ?? landscapeImg} alt={item.name} class="product-img" sizes="(max-width: 520px) 90vw, 300px" />
                <div class="product-meta">
                  <div class="product-row">
                    <h4 class="product-name">{item.name}</h4>
                    <span class="product-price mono">{item.price}</span>
                  </div>
                  {item.description && <p class="product-desc">{item.description}</p>}
                  {item.tags.length > 0 && (
                    <ul class="product-tags" role="list">
                      {item.tags.map((t) => <li class="tag mono">{t}</li>)}
                    </ul>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  {/* ==================================== 8 · TESTIMONIAL ========= */}
  {lead && (
    <section class="testimonial section" data-anim={f.reveal ? 'reveal' : undefined}>
      <figure class="container testimonial-inner">
        <blockquote class="testimonial-quote">“{lead.quote}”</blockquote>
        <figcaption class="testimonial-by mono">
          {lead.name}{lead.role && <span class="testimonial-role"> · {lead.role}</span>}
        </figcaption>
      </figure>
    </section>
  )}

  {/* ============================ 9 · FIND US + NEWSLETTER ======= */}
  <section class="findus section" data-anim={f.reveal ? 'reveal' : undefined}>
    <div class="container findus-grid">
      <div class="findus-info">
        <p class="eyebrow">Visit</p>
        <h2>{home.findTitle}</h2>
        <address class="findus-address">
          <p>{siteConfig.address.street}<br />{siteConfig.address.city}, {siteConfig.address.state} {siteConfig.address.zip}</p>
          <ul class="findus-hours" role="list">
            {siteConfig.hours.map((h) => (
              <li>
                <span class="mono">{h.days}</span>
                <span class="mono findus-hours-time">{h.close ? `${h.open}–${h.close}` : h.open}</span>
              </li>
            ))}
          </ul>
          <p class="findus-contact">
            <a href={`tel:${siteConfig.phone.replace(/[^+\d]/g, '')}`}>{siteConfig.phone}</a><br />
            <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
          </p>
        </address>
      </div>

      <div class="findus-news on-dark">
        <h2 class="news-title">{home.newsletterTitle}</h2>
        {home.newsletterBody && <p class="news-body">{home.newsletterBody}</p>}
        <NewsletterForm variant="page" />
      </div>
    </div>
  </section>
  {/* Footer comes from BaseLayout. */}
</BaseLayout>

<style>
  /* The homepage rides on ONE background tone (cream, the page default). Only
     three deliberate dark/accent moments break it: the hero photo, the
     full-bleed signature block, the burgundy marquee ribbon, and the footer.
     Sections separate by rhythm (consistent vertical padding), not color. */
  .section { padding-block: clamp(3.25rem, 7vw, 6rem); }

  /* Hand-drawn section-break ornaments. */
  .home-break { display: flex; justify-content: center; }
  .editorial-inner .home-break { margin-top: var(--space-7); }
  .home-break--toast { padding-block: var(--space-6); }

  /* ============================ 1 · HERO (editorial, type-led) ===== */
  .hero-ed {
    background: linear-gradient(180deg, var(--butter), var(--surface-0) 72%);
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--nav-h));
    padding-block: clamp(2rem, 6vw, 5rem);
  }
  .hero-ed-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(var(--space-6), 5vw, var(--space-8));
    align-items: center;
    width: 100%;
  }
  .hero-ed-headline {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: var(--t-hero);
    line-height: var(--lh-tight);
    letter-spacing: -0.012em;
    color: var(--ink);
    text-wrap: balance;
  }
  .hero-ed-lede {
    margin-top: var(--space-4);
    color: var(--body);
    font-size: clamp(17px, 1.4vw, 20px);
    max-width: 44ch;
  }
  .hero-ed-cta { margin-top: var(--space-6); }
  .hero-ed-sketch { margin-top: var(--space-7); }
  /* Framed, secondary photo (not a full-bleed blurred card). */
  .hero-ed-media {
    position: relative;
    border-radius: var(--radius-lg);
    border: 1px solid color-mix(in srgb, var(--clay) 30%, transparent);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    background: var(--surface-2);
  }
  @media (max-width: 860px) {
    .hero-ed { min-height: 0; }
    .hero-ed-grid { grid-template-columns: 1fr; gap: var(--space-6); }
    .hero-ed-media { order: -1; }
    .hero-ed-sketch { display: none; }
  }
  @media (max-width: 430px) {
    .hero-ed-headline { font-size: clamp(34px, 11vw, 48px); }
  }

  /* ===================================== 1 · HERO (photo) ===== */
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    overflow: hidden;
  }
  .hero-video { display: none; }
  .hero-video:not([data-hero-video=""]) {
    display: block;
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Stronger scrim so the headline + body are legible over ANY hero photo. */
  .hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(100deg, color-mix(in srgb, var(--ink) 84%, transparent) 0%, color-mix(in srgb, var(--ink) 52%, transparent) 48%, color-mix(in srgb, var(--ink) 28%, transparent) 100%),
      linear-gradient(0deg, color-mix(in srgb, var(--ink) 30%, transparent), transparent 45%);
  }
  .hero-grid { position: relative; z-index: 2; width: 100%; }
  .hero-panel {
    max-width: clamp(320px, 52vw, 600px);
    margin-inline-start: clamp(0px, 2vw, 40px);
    padding: clamp(1.5rem, 4vw, 3rem);
    background: color-mix(in srgb, var(--ink) 46%, transparent);
    border: 1px solid color-mix(in srgb, var(--surface-0) 22%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(120%);
    backdrop-filter: blur(12px) saturate(120%);
    border-radius: var(--radius-lg);
    box-shadow:
      0 24px 60px color-mix(in srgb, var(--ink) 46%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--surface-0) 20%, transparent);
    color: var(--surface-0);
  }
  .hero-eyebrow { color: color-mix(in srgb, var(--surface-0) 84%, transparent); }
  .hero-headline {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-weight: 300;
    font-style: italic;
    font-size: var(--t-hero);
    line-height: var(--lh-tight);
    letter-spacing: -0.012em;
    color: var(--surface-0);
    text-wrap: balance;
    text-shadow: 0 1px 24px color-mix(in srgb, var(--ink) 40%, transparent);
  }
  .hero-lede {
    margin-top: var(--space-4);
    color: color-mix(in srgb, var(--surface-0) 92%, transparent);
    font-size: clamp(17px, 1.4vw, 20px);
    max-width: 42ch;
  }
  .hero-cta { margin-top: var(--space-6); }

  /* ================================ 2 · EDITORIAL ===== */
  .editorial-inner { max-width: 720px; margin-inline: auto; padding-inline: var(--gutter); text-align: center; }
  .editorial-line {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--t-h2);
    color: var(--ink);
    margin-bottom: var(--space-5);
  }
  .editorial-body { margin-inline: auto; color: var(--body); }
  .editorial-body + .editorial-body { margin-top: var(--space-4); }
  .editorial-mission {
    margin-top: var(--space-6);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(20px, 2.2vw, 28px);
    color: var(--burgundy);
    max-width: 28ch;
    margin-inline: auto;
  }

  /* ================================ MARQUEE (accent) ===== */
  .marquee {
    background: var(--burgundy);
    color: var(--butter);
    padding-block: var(--space-4);
    overflow: hidden;
  }
  .marquee-track { display: flex; white-space: nowrap; }
  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-5);
    padding-inline: var(--space-3);
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(18px, 2vw, 26px);
  }
  .marquee-dot { color: var(--coral); }

  /* ================================ ALT-BLOCKS ===== */
  .block h2 { margin-bottom: var(--space-3); }

  .block--fullbleed { position: relative; min-height: min(70vh, 560px); display: flex; align-items: flex-end; overflow: hidden; }
  .block-overlay { position: absolute; inset: 0; z-index: 1; background: linear-gradient(0deg, color-mix(in srgb, var(--ink) 76%, transparent), transparent 72%); }
  .block-fb-text { position: relative; z-index: 2; padding-block: var(--space-8); max-width: 620px; }
  .block-fb-text h2, .block-fb-text p { color: var(--surface-0); }

  .block-numeral-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(var(--space-5), 5vw, var(--space-8)); align-items: center; }
  .big-numeral { font-family: var(--font-display); font-size: clamp(60px, 9vw, 120px); line-height: 0.9; color: color-mix(in srgb, var(--clay) 40%, transparent); display: block; margin-bottom: var(--space-3); }

  .block-duo-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(var(--space-5), 5vw, var(--space-8)); align-items: center; }
  .block-duo-imgs { position: relative; min-height: 420px; }

  /* ================================ MENU ===== */
  .menu-cat { margin-top: var(--space-7); }
  .menu-cat:first-of-type { margin-top: var(--space-5); }
  .menu-cat-title { font-size: 22px; color: var(--clay); margin-bottom: var(--space-4); }
  /* auto-fit so each category's items fill the row evenly (no orphan gaps). */
  .product-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: var(--space-5); }
  .product-card {
    display: flex;
    flex-direction: column;
    background: var(--surface-1);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
    transition: transform var(--dur) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }
  .product-meta { padding: var(--space-4); display: flex; flex-direction: column; flex: 1; }
  .product-row { display: flex; justify-content: space-between; gap: var(--space-3); align-items: baseline; }
  .product-name { font-size: 20px; }
  .product-price { color: var(--burgundy); }
  .product-desc { margin-top: var(--space-2); font-size: 14px; color: var(--muted); }
  .product-tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: auto; padding-top: var(--space-3); }
  .tag { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; padding: 0.2rem 0.5rem; border: 1px solid color-mix(in srgb, var(--clay) 55%, transparent); border-radius: var(--radius-pill); color: var(--burgundy); }

  /* ================================ TESTIMONIAL ===== */
  .testimonial { text-align: center; }
  .testimonial-inner { max-width: 800px; }
  .testimonial-quote { font-family: var(--font-display); font-style: italic; font-weight: 300; font-size: clamp(26px, 3.4vw, 44px); line-height: 1.25; color: var(--ink); }
  .testimonial-by { margin-top: var(--space-5); color: var(--muted); letter-spacing: 0.08em; text-transform: uppercase; font-size: 12px; }
  .testimonial-role { color: var(--clay); }

  /* ================================ FIND US ===== */
  .findus-grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(var(--space-5), 5vw, var(--space-7)); align-items: stretch; }
  .findus-info h2 { margin: var(--space-2) 0 var(--space-5); }
  .findus-address { font-style: normal; line-height: 1.8; }
  .findus-hours { margin: var(--space-4) 0; font-size: 14px; max-width: 360px; }
  .findus-hours li { display: flex; justify-content: space-between; gap: var(--space-3); padding: 2px 0; }
  .findus-hours-time { color: var(--muted); }
  .findus-contact a { color: var(--burgundy); }

  /* Burgundy (not ink) so it doesn't fuse with the ink footer directly below. */
  .findus-news {
    background: var(--burgundy);
    color: var(--surface-0);
    border-radius: var(--radius-lg);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .news-title { color: var(--surface-0); }
  .news-body { margin: var(--space-3) 0 var(--space-5); color: color-mix(in srgb, var(--surface-0) 78%, transparent); }

  /* ===================================== Responsive ===== */
  @media (max-width: 860px) {
    .block-numeral-grid,
    .block-duo-grid,
    .findus-grid { grid-template-columns: 1fr; }
    .block-duo-imgs { min-height: 0; display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }
  }
  /* Tighten the hero on phones so the panel doesn't dominate the screen. */
  @media (max-width: 430px) {
    .hero { min-height: 78svh; }
    .hero-panel { padding: 1.25rem 1.25rem 1.5rem; }
  }
</style>
