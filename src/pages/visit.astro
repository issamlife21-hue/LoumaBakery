---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../config/site';
import { features as f } from '../config/features';

const c = (await getEntry('copy', 'visit'))!.data;
const { address, hours } = siteConfig;

// Only ever frame a real Google Maps embed. A CMS editor can change this string,
// so validate the origin at build time; anything else falls back to the static
// placeholder rather than framing an arbitrary site under our domain.
const mapEmbed =
  typeof c.mapEmbed === 'string' && /^https:\/\/www\.google\.com\/maps\/embed/.test(c.mapEmbed)
    ? c.mapEmbed
    : undefined;
---

<BaseLayout title="Visit" description={c.lede} schema="localbusiness">
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      {c.openingTag && <p class="opening-tag mono">{c.openingTag}</p>}
      {c.lede && <p class="lede">{c.lede}</p>}
    </div>
  </header>

  <section class="visit" data-anim={f.reveal ? 'reveal' : undefined}>
    <div class="container visit-grid">
      <div class="visit-info">
        <div class="info-block">
          <h2 class="info-h smallcaps">Hours</h2>
          <ul class="hours" role="list">
            {hours.map((h) => (
              <li>
                <span class="mono">{h.days}</span>
                <span class="mono hours-time">{h.close ? `${h.open}–${h.close}` : h.open}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="info-block">
          <h2 class="info-h smallcaps">Address</h2>
          <address class="addr">
            <p>{address.street}<br />{address.city}, {address.state} {address.zip}</p>
            <p class="addr-contact">
              <a href={`tel:${siteConfig.phone.replace(/[^+\d]/g, '')}`}>{siteConfig.phone}</a><br />
              <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
            </p>
          </address>
        </div>

        {c.body.length > 0 && (
          <div class="info-block">
            <h2 class="info-h smallcaps">Getting here</h2>
            {c.body.map((p) => <p class="directions">{p}</p>)}
          </div>
        )}
      </div>

      <div class="visit-map">
        {mapEmbed ? (
          <div class="map-shell" data-map-src={mapEmbed}>
            {/* Tap-to-load facade: the iframe stays off the critical path on
                mobile (and can't scroll-trap). Desktop auto-loads it lazily. */}
            <button type="button" class="map-facade" data-map-load>
              <span class="map-facade-addr mono">
                {address.street}<br />{address.city}, {address.state} {address.zip}
              </span>
              <span class="btn map-facade-btn" aria-hidden="true">Load map</span>
            </button>
          </div>
        ) : (
          <div class="ph ph-a map-frame" aria-hidden="true"></div>
        )}
        <a
          class="map-link mono"
          href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${address.street}, ${address.city}, ${address.state} ${address.zip}`)}`}
          target="_blank"
          rel="noopener"
        >
          Open in Google Maps ↗
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .opening-tag {
    display: inline-block;
    margin-top: var(--space-3);
    padding: 0.3rem 0.8rem;
    background: var(--coral);
    color: var(--ink);
    border-radius: var(--radius-pill);
    font-size: 12px;
    letter-spacing: 0.04em;
  }

  .visit { padding-block: var(--space-8) var(--space-9); }
  .visit-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: var(--space-7); align-items: start; }

  .info-block + .info-block { margin-top: var(--space-7); }
  /* Sub-labels share the site-wide label language (mono tracked + clay dash). */
  .info-h {
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    font-family: var(--font-mono);
    font-size: var(--t-eyebrow);
    letter-spacing: var(--track-eyebrow);
    text-transform: uppercase;
    font-weight: 500;
    color: var(--muted);
    margin-bottom: var(--space-3);
  }
  .info-h::before {
    content: "";
    width: 1.4em;
    height: 2px;
    border-radius: 1px;
    background: var(--clay);
  }
  .hours { display: flex; flex-direction: column; gap: var(--space-2); max-width: 360px; }
  .hours li { display: flex; justify-content: space-between; gap: var(--space-3); }
  .hours-time { color: var(--muted); }
  .addr { font-style: normal; line-height: 1.8; }
  .addr-contact { margin-top: var(--space-3); }
  .addr-contact a { color: var(--burgundy); }
  .directions { color: var(--body); max-width: 52ch; }
  .directions + .directions { margin-top: var(--space-3); }

  .visit-map { position: sticky; top: calc(var(--nav-h) + var(--space-4)); }
  .map-shell {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-lg);
    border: 1px solid var(--hairline-strong);
    overflow: hidden;
    background: var(--butter);
  }
  .map-shell iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .map-facade {
    position: absolute;
    inset: 0;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-4);
    background: var(--butter);
    border: 0;
    text-align: center;
  }
  .map-facade-addr { color: var(--body); font-size: 15px; line-height: 1.7; }
  .map-facade-btn { pointer-events: none; }
  .map-frame {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    border: 0;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-md);
    /* fallback tint behind the embed (visible only if it fails to load) */
    background: linear-gradient(135deg, var(--surface-2), var(--surface-3));
  }
  .map-link {
    display: inline-block;
    margin-top: var(--space-3);
    font-size: 13px;
    color: var(--burgundy);
  }
  .map-link:hover { color: var(--red); }

  @media (max-width: 820px) {
    .visit-grid { grid-template-columns: 1fr; }
    .visit-map { position: static; }
  }
</style>

<script>
  // Map facade: inject the iframe on tap (touch) or automatically once the
  // shell nears the viewport (hover/desktop devices keep the lazy feel).
  const shell = document.querySelector<HTMLElement>('.map-shell');
  if (shell) {
    const src = shell.dataset.mapSrc!;
    const load = () => {
      if (shell.dataset.loaded) return;
      shell.dataset.loaded = 'true';
      const f = document.createElement('iframe');
      f.src = src;
      f.title = 'Map to Louma Bakery';
      f.loading = 'lazy';
      f.referrerPolicy = 'no-referrer-when-downgrade';
      f.setAttribute('sandbox', 'allow-scripts allow-same-origin allow-popups allow-popups-to-escape-sandbox');
      f.setAttribute('allowfullscreen', '');
      shell.appendChild(f);
      shell.querySelector('.map-facade')?.remove();
    };
    shell.querySelector('[data-map-load]')?.addEventListener('click', load);
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      const io = new IntersectionObserver((es) => {
        if (es.some((e) => e.isIntersecting)) { io.disconnect(); load(); }
      }, { rootMargin: '200px' });
      io.observe(shell);
    }
  }
</script>
