---
import { getEntry, getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { features as f } from '../config/features';
import { Face } from '../lib/brand';
import Img from '../components/Img.astro';
import portraitImg from '../assets/placeholders/portrait.jpg';
import squareImg from '../assets/placeholders/square.jpg';

const c = (await getEntry('copy', 'story'))!.data;
const chapters = (await getCollection('storyChapters')).sort((a, b) => a.data.order - b.data.order);
const ingredients = await getCollection('ingredients');
const founder = c.founder;
---

<BaseLayout title="Our Story" description={c.lede}>
  <header class="page-head">
    <div class="container">
      <p class="eyebrow">{c.eyebrow}</p>
      <h1>{c.title}</h1>
      {c.lede && <p class="lede">{c.lede}</p>}
    </div>
  </header>

  {/* Intro */}
  <section class="story-intro" data-anim={f.reveal ? 'reveal' : undefined}>
    <div class="container narrow">
      {c.body.map((p) => <p class="story-p">{p}</p>)}
    </div>
  </section>

  {/* Chapters rail (alternating) */}
  <div class="chapters" data-anim={f.storyRail ? 'story-rail' : undefined}>
    {chapters.map((ch, i) => (
      <section class={`chapter ${i % 2 ? 'chapter--flip' : ''}`} data-anim={f.reveal ? 'reveal' : undefined}>
        <div class="container chapter-grid">
          <Img src={portraitImg} alt={ch.data.title} class="chapter-img" tilt={f.imageTilt} sizes="(max-width: 820px) 100vw, 50vw" />
          <div class="chapter-text">
            {ch.data.eyebrow && <span class="big-numeral" aria-hidden="true">{ch.data.eyebrow}</span>}
            <h2>{ch.data.title}</h2>
            <p>{ch.data.body}</p>
          </div>
        </div>
      </section>
    ))}
  </div>

  {/* Founder */}
  {founder && (
    <section class="founder" data-anim={f.reveal ? 'reveal' : undefined}>
      <div class="container founder-grid">
        <div class="founder-portrait">
          <Img src={portraitImg} alt={`${founder.name}, ${founder.role}`} class="founder-img" sizes="(max-width: 820px) 100vw, 40vw" />
          <Face class="founder-mark" width={48} height={44} aria-hidden="true" />
        </div>
        <div class="founder-text">
          <p class="eyebrow">{founder.role}</p>
          <h2 class="founder-name">{founder.name}</h2>
          {founder.body.map((p) => <p>{p}</p>)}
        </div>
      </div>
    </section>
  )}

  {/* Ingredient slider */}
  {ingredients.length > 0 && (
    <section class="ingredients" data-anim={f.ingredientSlider ? 'ingredient-slider' : undefined}>
      <div class="container sec-head">
        <p class="eyebrow">What goes in</p>
        <h2>A short list, done well</h2>
      </div>
      <ul class="ing-track" role="list">
        {ingredients.map((ing) => (
          <li class="ing-card">
            <Img src={squareImg} alt={ing.data.name} class="ing-img" sizes="240px" />
            <h3 class="ing-name">{ing.data.name}</h3>
            {ing.data.note && <p class="ing-note">{ing.data.note}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  .narrow { max-width: 720px; }
  .story-intro { padding-block: var(--space-8); }
  .story-p { font-size: clamp(18px, 1.6vw, 21px); color: var(--body); }
  .story-p + .story-p { margin-top: var(--space-4); }

  .chapter { padding-block: var(--space-7); }
  .chapter-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-7); align-items: center; }
  .chapter--flip .chapter-img { order: 2; }
  .chapter-img { aspect-ratio: 4 / 5; border-radius: var(--radius-lg); }
  .big-numeral { font-family: var(--font-display); font-size: clamp(48px, 7vw, 88px); line-height: 0.9; color: color-mix(in srgb, var(--clay) 38%, transparent); display: block; margin-bottom: var(--space-2); }
  .chapter-text h2 { margin-bottom: var(--space-3); }

  .founder { padding-block: var(--space-9); background: var(--surface-1); }
  .founder-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: var(--space-7); align-items: center; }
  .founder-portrait { position: relative; }
  .founder-img { aspect-ratio: 3 / 4; border-radius: var(--radius-lg); }
  .founder-mark { position: absolute; bottom: -16px; right: -8px; color: var(--red); }
  .founder-name { margin: var(--space-2) 0 var(--space-4); }
  .founder-text p + p { margin-top: var(--space-4); }

  .ingredients { padding-block: var(--space-8) var(--space-9); }
  .ing-track {
    display: flex;
    gap: var(--space-4);
    overflow-x: auto;
    padding-inline: var(--gutter);
    padding-bottom: var(--space-3);
    scroll-snap-type: x mandatory;
  }
  .ing-card { flex: 0 0 auto; width: min(70vw, 240px); scroll-snap-align: start; }
  .ing-img { aspect-ratio: 1; border-radius: var(--radius-md); }
  .ing-name { margin-top: var(--space-3); font-size: 22px; }
  .ing-note { margin-top: var(--space-1); color: var(--muted); font-size: 14px; }

  @media (max-width: 820px) {
    .chapter-grid,
    .founder-grid { grid-template-columns: 1fr; }
    .chapter--flip .chapter-img { order: -1; }
    .chapter-img { order: -1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ing-track { scroll-snap-type: none; }
  }
</style>
